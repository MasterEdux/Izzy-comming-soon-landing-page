# Copia estas variables en Easy Panel (servicio > Environment). NUNCA subas un .env real a GitHub.

# --- Base de datos de producción (Supabase) ---------------------------------
# Usa el rol restringido de docs/supabase-rol.sql con la cadena del "Transaction pooler" (puerto 6543).
DATABASE_URL=postgresql://izzy_landing.PROYECTO:CLAVE@aws-0-REGION.pooler.supabase.com:6543/postgres

# --- Seguridad ---------------------------------------------------------------
# Mínimo 32 caracteres aleatorios. Genera uno con: openssl rand -base64 48
TOKEN_SECRET=

# --- Sitio y dominios --------------------------------------------------------
SITE_URL=https://www.izzy.com.gt
SOCIAL_HOST=social.izzy.com.gt

# --- Campaña -----------------------------------------------------------------
PREREG_LIMIT=100
PREREG_Q25=50

# --- SMS (labsMobile). Sin LABSMOBILE_USER el SMS queda en modo simulado ------
LABSMOBILE_USER=
LABSMOBILE_TOKEN=
LABSMOBILE_SENDER=Izzy

# --- Correo (SMTP de un buzón de izzy.com.gt). Sin SMTP_HOST queda simulado ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Izzy <hola@izzy.com.gt>"

# --- Anti bots (Cloudflare Turnstile, gratis) --------------------------------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# --- Hoja de Google Sheets (Apps Script de server/apps-script/Code.gs) -------
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=
